#
# The pre-push gate. Until CI runners start for this repository, this hook is
# the gate every push passes (CLAUDE.md section 10): the fast checks, then a
# debug build and the unit tier. Installed by python build/install_hooks.py.
set -e
cd "$(git rev-parse --show-toplevel)"
python build/check.py --fast
cmake --preset mingw-debug > /dev/null
cmake --build --preset mingw-debug
ctest --preset unit
